{
  "name": "softcatala-frontend",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite build --watch",
    "prebuild": "npm run test",
    "build": "vite build && npm run build:editor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:editor": "sass --no-source-map --style=compressed src/scss/editor.scss ../static/css/editor.min.css"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@types/node": "^24.19.2",
    "@wordpress/block-library": "^12.1.0",
    "@wordpress/blocks": "^17.1.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass-embedded": "^1.87.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@types/sortablejs": "^1.15.9",
    "sortablejs": "^1.15.7"
  }
}
