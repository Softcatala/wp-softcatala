{# One Revive ad slot. Expects `slot` (its name) and the global `ads` context. #}
{% set ad = ads.slots[slot] ?? null %}
{% if ad %}
    {% if ads.debug %}
    <div class="sc-ad-debug">
        <span class="sc-ad-debug__label">{{ slot }} · {{ ad.zone ?: 'cap' }} · {{ ad.source }}</span>
    {% endif %}
    {% if ad.zone %}
        {% do ads_mark_rendered() %}
        <ins data-revive-zoneid="{{ ad.zone }}" data-revive-id="{{ ads.revive_id }}"></ins>
    {% endif %}
    {% if ads.debug %}
    </div>
    {% endif %}
{% endif %}
