{% extends "base.twig" %}

{% block content %}
    <!-- .main .wrap-blanc -->
    <main class="main blog wrap-blanc">
        <!-- .main-header -->
        {% include "contingut-header.twig" %}
        <!--/.main-header -->

        <div class="container-fluid">
            <div class="row">
                 <!-- .contingut -->
                <div class="contingut contingut-left col-sm-12 col-md-9">
                    <div class="llistat-dades-obertes">
                        <p>En aquesta pàgina trobareu tots els conjunts de dades que Softcatalà ha creat com ara corpus i diccionaris. Les dades són clau en els sistemes de lingüística computacional, i imprescindibles per a l’aprenentatge automàtic. Obrim aquests dades amb l'esperit que serveixen a tothom per crear nous projectes.</p>
                        {% if posts %}
                        {% for dadesobertes in posts %}
                        <div class="contingut-dades-obertes">
                            <h2><a href="{{dadesobertes.link}}">{{ dadesobertes.title }}</a>{% if dadesobertes.is_new() %} <span class="dades-obertes-nou">nou</span>{% endif %}</h2>
                            <div class="article-cont">
                                    <p>{{ dadesobertes.post_excerpt }}</p>
                                    <p class="dades-obertes-meta">
                                        {% if dadesobertes.hf_downloads %}
                                            <span title="Baixades a Hugging Face (darrers 30 dies)"><i class="fas fa-download" aria-hidden="true"></i> {{ dadesobertes.hf_downloads|number_format(0, ',', '.') }} baixades</span>
                                        {% endif %}
                                        {% if dadesobertes.hf_likes %}
                                            <span title="«M'agrada» a Hugging Face"><i class="fas fa-heart" aria-hidden="true"></i> {{ dadesobertes.hf_likes|number_format(0, ',', '.') }} «m'agrada»</span>
                                        {% endif %}
                                        {% if dadesobertes.license_license_name %}
                                            <span><i class="fas fa-scale-balanced" aria-hidden="true"></i>
                                            {% if dadesobertes.license_license_url %}<a href="{{ dadesobertes.license_license_url }}">{{ dadesobertes.license_license_name }}</a>{% else %}{{ dadesobertes.license_license_name }}{% endif %}</span>
                                        {% endif %}
                                        {% if dadesobertes.download_url %}
                                            <span><i class="fas fa-up-right-from-square" aria-hidden="true"></i> <a href="{{ dadesobertes.download_url }}">Baixa les dades</a></span>
                                        {% endif %}
                                    </p>
                            </div><!-- Extracte dades obertes -->
                            <hr class="clara">
                        </div>
                        {% endfor %}
                    </div>
                    <!-- .pagination -->
                    {% include "pagination.twig" %}
                    <!-- /.pagination -->
                    {% else %}
                        No hi ha cap dada oberta per mostrar
                    {% endif %}<!--/.pagination -->
                </div><!--/.contingut -->
                
                {% include "sidebar.twig" %}
            </div><!--/.row -->
        </div><!--/.container-fluid -->
    </main><!--/.main .wrap-blanc -->

    <!-- .seccio-vermella -->
    {% include "form-novetats.twig" %}
    {% include "call-to-action-bottom.twig" %}
    <!--/.seccio-vermella -->

{% endblock %}
