{% extends "base.twig" %}

{% block content %}
	<main class="main wrap-blanc blog">
		{% include "contingut-header.twig" %}

		<div class="container-fluid">
			<div class="row">
				<div class="contingut contingut-left col-sm-9">
					<div class="dades-obertes">
						<div class="row">
							<div class="col-sm-9">
								<h2>Descripció</h2>
								<p>{{ post.content }}</p>
								{% if post.download_url %}
									<h2>Adreça de descàrrega</h2>
									<a href="{{ post.download_url }}">{{ post.download_url }}</a>
								{% endif %}
							</div>

							<div class="col-sm-3 dades-obertes-lat">
								{% if creators %}
									<div class="dades-obertes-item-lateral">
										<h2>{{ creators|length > 1 ? 'Autors' : 'Autor' }}</h2>
										{% for creator in creators %}
											<p>{{ creator.creator_name }}</p>
										{% endfor %}
									</div>
								{% endif %}

								{% if post.hf_repo_id and (post.hf_downloads or post.hf_likes) %}
									<div class="dades-obertes-item-lateral">
										<h2>Hugging Face</h2>
										{% if post.hf_downloads %}
											<p class="dades-obertes-hf-stat"><i class="fas fa-download" aria-hidden="true"></i> {{ post.hf_downloads|number_format(0, ',', '.') }} baixades (darrers 30 dies)</p>
										{% endif %}
										{% if post.hf_likes %}
											<p class="dades-obertes-hf-stat"><i class="fas fa-heart" aria-hidden="true"></i> {{ post.hf_likes|number_format(0, ',', '.') }} «m'agrada»</p>
										{% endif %}
									</div>
								{% endif %}

								{% if post.license_license_name %}
									<div class="dades-obertes-item-lateral">
										<h2>Llicència</h2>
										<p>
											{% if post.license_license_url %}<a href="{{ post.license_license_url }}">{% endif %}
											{{ post.license_license_name }}
											{% if post.license_license_url %}</a>{% endif %}
										</p>
									</div>
								{% endif %}
							</div>
						</div>
					</div>

					<script type="application/ld+json">
					{
						"@context": "https://schema.org",
						"@type": "Dataset",
						"@id": {{ (post.link ~ '#dataset')|json_encode|raw }},
						"url": {{ post.link|json_encode|raw }},
						"name": {{ (post.namedts ?: post.title)|json_encode|raw }},
						"description": {{ (post.description ?: post.content|striptags)|json_encode|raw }},
						"isPartOf": { "@id": {{ (post.link ~ '#webpage')|json_encode|raw }} }
						{% if creators %},
						"creator": [
							{% for creator in creators %}
							{
								"@type": {{ (creator.author_type == 'organization' ? 'Organization' : 'Person')|json_encode|raw }},
								"name": {{ creator.creator_name|json_encode|raw }}
							}{{ not loop.last ? ',' : '' }}
							{% endfor %}
						]
						{% endif %}
						{% if post.license_license_name %},
						"license": {
							"@type": "CreativeWork",
							"name": {{ post.license_license_name|json_encode|raw }}{% if post.license_license_url %},
							"url": {{ post.license_license_url|json_encode|raw }}{% endif %}
						}
						{% endif %}
						{% if post.download_url %},
						"distribution": {
							"@type": "DataDownload",
							"contentUrl": {{ post.download_url|json_encode|raw }}{% if post.format %},
							"encodingFormat": {{ post.format|json_encode|raw }}{% endif %}
						}
						{% endif %}
					}
					</script>
				</div>

				{% include "sidebar.twig" %}
			</div>
		</div>
	</main>

	{% include "call-to-action-bottom.twig" %}
{% endblock %}
