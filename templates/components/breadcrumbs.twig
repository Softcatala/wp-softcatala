{% if breadcrumbs %}
    <style>
        .breadcrumbs {
            margin-bottom: 20px;
        }

        .breadcrumbs a {
            font-weight: 300;
            margin: 4px 5px 0 0;
        }

        .breadcrumbs ol {
            display: inline;
            margin-left: 0;
            padding-left: 0;
        }

        .breadcrumbs ol li {
            display: inline;
        }
    </style>
    <nav class="breadcrumbs" style="clear: both;font-size: 14px;">
        <ol>
    {% for breadcrumb in breadcrumbs %}
            <li><a
                        href="{{ breadcrumb.link }}" {% if loop.last %}aria-current='location'{% endif %}
                >{{ breadcrumb.text }}</a>{% if not loop.last %}<span aria-hidden="true"> / </span>{% endif %}</li>
    {% endfor %}
        </ol>
    </nav>
{% endif %}
